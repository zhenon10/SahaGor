{
  "AllowedHosts": "*",
  "Jwt": {
    "Yayinlayan": "SahaGor",
    "Kitle": "SahaGor.Istemciler",
    "ErisimTokeniDakika": 15,
    "YenilemeTokeniGunSayisi": 7
  },
  "DosyaDepolama": {
    "KokDizin": "App_Data/gorev-fotograflari"
  },
  "Entegrasyonlar": {
    "Hat153": {
      "PaylasilanGizliAnahtar": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.SignalR": "Warning",
        "Microsoft.AspNetCore.Http.Connections": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sahagor-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}{NewLine}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Uygulama": "SahaGor.Api"
    }
  }
}
