# Bu dosyayi ".env" olarak kopyalayip kendi ortaminiza gore degerleri doldurun.
# ".env" dosyasi asla git'e commit edilmemelidir (bkz. .gitignore).

# --- PostgreSQL / PostGIS ---
POSTGRES_DB=sahagor
POSTGRES_USER=sahagor_user
POSTGRES_PASSWORD=degistirilmesi_zorunlu_guclu_bir_sifre
POSTGRES_PORT=5432

# --- pgAdmin (opsiyonel, sadece "dev-tools" profile ile calisir) ---
PGADMIN_EMAIL=admin@sahagor.local
PGADMIN_PASSWORD=degistirilmesi_zorunlu_guclu_bir_sifre
PGADMIN_PORT=5050

# --- JWT (Api Sprint 4'te containerize edildiginde kullanilacak; asagidaki cift alt
#     cizgi ".Net konfigurasyon" kurallarina gore "Jwt:Anahtar" degerine karsilik gelir) ---
Jwt__Anahtar=en-az-32-karakter-uzunlugunda-rastgele-ve-gizli-bir-anahtar-belirleyin
