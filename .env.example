# Bu dosyayi ".env" olarak kopyalayip kendi ortaminiza gore degerleri doldurun.
# ".env" dosyasi asla git'e commit edilmemelidir (bkz. .gitignore).

# --- PostgreSQL / PostGIS ---
POSTGRES_DB=sahagor
POSTGRES_USER=sahagor_user
POSTGRES_PASSWORD=degistirilmesi_zorunlu_guclu_bir_sifre
POSTGRES_PORT=5432

# --- pgAdmin (opsiyonel, sadece "dev-tools" profile ile calisir) ---
PGADMIN_EMAIL=admin@sahagor.local
PGADMIN_PASSWORD=degistirilmesi_zorunlu_guclu_bir_sifre
PGADMIN_PORT=5050

# --- Production dagitimi (docker-compose.prod.yml, SG-422) icin gerekli degerler ---

# Jwt:Anahtar - en az 32 karakter, rastgele ve gizli. Ortamlar arasi FARKLI olmalidir.
JWT_ANAHTAR=en-az-32-karakter-uzunlugunda-rastgele-ve-gizli-bir-anahtar-belirleyin

# Entegrasyonlar:Hat153:PaylasilanGizliAnahtar - 153 hattiyla webhook imza dogrulamasinda
# paylasilan HMAC-SHA256 anahtari, en az 16 karakter.
HAT153_GIZLI_ANAHTAR=en-az-16-karakter-uzunlugunda-rastgele-ve-gizli-bir-anahtar-belirleyin

# Web admin panelinin tarayicidan VE kendi konteynerinden erisebilecegi PUBLIC API adresi
# (orn. https://api.sahagor.example.com). "sahagor-api" gibi ic Docker DNS adi KULLANILAMAZ.
API_PUBLIC_BASE_URL=https://api.sahagor.example.com

# Konteynerlerin host'ta dinleyecegi portlar (opsiyonel, varsayilanlar gosterilmistir).
API_PORT=5299
WEB_PORT=3000
